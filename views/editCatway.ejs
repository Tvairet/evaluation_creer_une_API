<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Modifier le catway</title>
</head>
<body>
  <h1>Modifier le catway</h1>
  <form id="editFormCatway">
    <label>Numéro :
      <input type="number" name="catwayNumber" value="<%= catway.catwayNumber %>" disabled>
      <small>(le numéro ne peut pas être modifié)</small>
    </label>
    <br>
    <label>Type :
      <select name="catwayType">
        <option value="long" <%= catway.catwayType === 'long' ? 'selected' : '' %>>long</option>
        <option value="short" <%= catway.catwayType === 'short' ? 'selected' : '' %>>short</option>
      </select>
      <small>(le type ne peut pas être modifié)</small>
    </label>
    <br>
    <label>Etat :
      <input type="text" name="catwayState" value="<%= catway.catwayState %>">
    </label>
    <br>
    <button type="submit">Enregistrer</button>
  </form>
  <script>
    const form = document.getElementById('editFormCatway');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Seul l'état du catway est modifiable (le numéro et le type ne le sont pas)
      const data = {
        catwayState: form.catwayState.value
      };

      const response = await fetch('/api/catways/<%= catway.id %>', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      if (response.ok) {
        window.location.href = '/dashboard';
      }
    });
  </script>
</body>
</html>
