<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Liste des réservations</title>
  <link rel="stylesheet" href="/assets/css/index.css">
</head>
<body>
    <header>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
  
  <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
    <div class="navbar-nav">
      <a class="nav-item nav-link active" href="/">Accueil</a>
      <a class="nav-item nav-link" href="/users">Utilisateurs</a>
      <a class="nav-item nav-link" href="reservations">Réservations</a>
      <a class="nav-item nav-link" href="/catways">Catways</a>
      <a class="nav-item nav-link" href="#">Tableau de bord</a>
    </div>
  </div>
</nav>
  </header>
  <h1>Liste des réservations</h1>
  <table>
    <thead>
      <tr>
        <th>Numéro du catway</th>
        <th>Nom du client</th>
        <th>Nom du bateau</th>
        <th>Date de début</th>
        <th>Date de fin</th>
      </tr>
    </thead>
    <tbody>
      <% reservations.forEach(reservation => { %>
        <tr>
          <td><%= reservation.catwayNumber %></td>
          <td><%= reservation.clientName %></td>
          <td><%= reservation.boatName %></td>
          <td><%= reservation.startDate %></td>
          <td><%= reservation.endDate %></td>
          <td><a href="/reservations/<%= reservation.id %>/edit"><button>Modifier</button></a></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</body>
</html>