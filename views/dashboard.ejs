<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Tableau de Bord</title>
  <link rel="stylesheet" href="/assets/css/index.css">
</head>
<body>
  <header>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
      <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
        <div class="navbar-nav">
          <a class="nav-item nav-link" href="/">Accueil</a>
          <a class="nav-item nav-link" href="/users">Utilisateurs</a>
          <a class="nav-item nav-link" href="/reservations">Réservations</a>
          <a class="nav-item nav-link" href="/catways">Catways</a>
          <a class="nav-item nav-link active" href="/dashboard">Tableau de bord</a>
          <a class="nav-item nav-link" href="/api-docs">Documentation API</a>
          <a class="nav-item nav-link" href="/auth/logout">Se déconnecter</a>
        </div>
      </div>
    </nav>
  </header>

  <h1>Tableau de Bord</h1>

  <% if (connectedUser) { %>
    <p>
      Connecté en tant que <strong><%= connectedUser.nom %></strong>
      (<%= connectedUser.email %>) — le <%= today.toLocaleDateString('fr-FR') %>
    </p>
  <% } %>

  <h2>Réservations en cours</h2>
  <table border="1" cellpadding="5">
    <thead>
      <tr><th>Catway</th><th>Client</th><th>Bateau</th><th>Début</th><th>Fin</th></tr>
    </thead>
    <tbody id="current-reservations-tbody">
      <tr><td colspan="5">Chargement…</td></tr>
    </tbody>
  </table>

  <h2>Utilisateurs</h2>
  <form id="addUserForm">
    <fieldset>
      <legend>Créer un utilisateur</legend>
      <label for="name">Nom</label>
      <input type="text" name="nom" required>
      <label for="email">Email</label>
      <input type="email" name="email" required>
      <label for="password">Mot de passe</label>
      <input type="password" name="password" required minlength="8">
      <button type="submit">Créer l'utilisateur</button>
    </fieldset>
  </form>
  <table border="1" cellpadding="5">
    <thead>
      <tr><th>Nom</th><th>Email</th><th></th><th></th></tr>
    </thead>
    <tbody id="users-tbody">
      <tr><td colspan="4">Chargement…</td></tr>
    </tbody>
  </table>

  <h2>Catways</h2>
  <form id="addCatwayForm">
    <fieldset>
      <legend>Créer un catway</legend>
      <label for="catwayNumber">Numéro du catway</label>
      <input type="number" name="catwayNumber" required>
      <label for="catwayType">Type du catway</label>
      <select name="catwayType" required>
        <option value="long">long</option>
        <option value="short">short</option>
      </select>
      <label for="catwayState">Etat du catway</label>
      <input type="text" name="catwayState" required>
      <button type="submit">Créer le catway</button>
    </fieldset>
  </form>
  <a href="/catways"><button type="button">Voir tous les catways</button></a>

  <h2>Réservations</h2>
  <form id="addReservationForm">
    <fieldset>
      <legend>Créer une réservation</legend>
      <label for="catwayNumber">Numéro du catway</label>
      <select name="catwayNumber" id="catway-select" required></select>
      <label for="clientName">Nom du client</label>
      <input type="text" name="clientName" required>
      <label for="boatName">Nom du bateau</label>
      <input type="text" name="boatName" required>
      <br>
      <label for="startDate">Date d'entrée</label>
      <input type="date" name="startDate" required>
      <label for="endDate">Date de sortie</label>
      <input type="date" name="endDate" required>
      <button type="submit">Créer la réservation</button>
    </fieldset>
  </form>

  <table border="1" cellpadding="5">
    <thead>
      <tr><th>Catway</th><th>Client</th><th>Bateau</th><th>Début</th><th>Fin</th><th></th><th></th></tr>
    </thead>
    <tbody id="reservations-tbody">
      <tr><td colspan="7">Chargement…</td></tr>
    </tbody>
  </table>
  <a href="/reservations">Toutes les réservations</a>

  <script>
    const fmt = (iso) => new Date(iso).toLocaleDateString('fr-FR');

    async function loadUsers() {
      const tbody = document.getElementById('users-tbody');
      const res = await fetch('/api/users/');
      if (!res.ok) {
        tbody.innerHTML = '<tr><td colspan="4">Accès réservé aux administrateurs</td></tr>';
        return;
      }
      const users = await res.json();
      tbody.innerHTML = users.map(u => `
        <tr>
          <td>${u.nom}</td>
          <td>${u.email}</td>
          <td><a href="/users/${u._id}/edit"><button type="button">Modifier</button></a></td>
          <td><button type="button" onclick="deleteUser('${u._id}')">Supprimer</button></td>
        </tr>
      `).join('');
    }

    async function deleteUser(id) {
      if (!confirm('Supprimer cet utilisateur ?')) return;
      const res = await fetch('/api/users/' + id, { method: 'DELETE' });
      if (res.ok) {
        loadUsers();
      } else {
        const err = await res.json().catch(() => ({}));
        alert(err.message || 'Erreur lors de la suppression');
      }
    }

    async function loadCatwaysSelect() {
      const select = document.getElementById('catway-select');
      const res = await fetch('/api/catways/');
      if (!res.ok) return;
      const catways = await res.json();
      select.innerHTML = catways.map(c => `<option value="${c.catwayNumber}">${c.catwayNumber}</option>`).join('');
    }

    async function loadReservations() {
      const tbody = document.getElementById('reservations-tbody');
      const currentTbody = document.getElementById('current-reservations-tbody');
      const res = await fetch('/api/reservations/');
      if (!res.ok) {
        tbody.innerHTML = '<tr><td colspan="7">Erreur de chargement</td></tr>';
        currentTbody.innerHTML = '<tr><td colspan="5">Erreur de chargement</td></tr>';
        return;
      }
      const reservations = await res.json();
      const today = new Date();

      tbody.innerHTML = reservations.map(r => `
        <tr>
          <td>${r.catwayNumber}</td>
          <td>${r.clientName}</td>
          <td>${r.boatName}</td>
          <td>${fmt(r.startDate)}</td>
          <td>${fmt(r.endDate)}</td>
          <td><a href="/reservations/${r._id}/edit"><button type="button">Modifier</button></a></td>
          <td><button type="button" onclick="deleteReservation('${r._id}')">Supprimer</button></td>
        </tr>
      `).join('');

      const current = reservations.filter(r => new Date(r.startDate) <= today && new Date(r.endDate) >= today);
      currentTbody.innerHTML = current.length
        ? current.map(r => `
            <tr>
              <td>${r.catwayNumber}</td>
              <td>${r.clientName}</td>
              <td>${r.boatName}</td>
              <td>${fmt(r.startDate)}</td>
              <td>${fmt(r.endDate)}</td>
            </tr>
          `).join('')
        : '<tr><td colspan="5">Aucune réservation en cours</td></tr>';
    }

    async function deleteReservation(id) {
      if (!confirm('Supprimer cette réservation ?')) return;
      const res = await fetch('/api/reservations/' + id, { method: 'DELETE' });
      if (res.ok) {
        loadReservations();
      } else {
        const err = await res.json().catch(() => ({}));
        alert(err.message || 'Erreur lors de la suppression');
      }
    }

    document.getElementById('addUserForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const data = {
        nom: form.nom.value,
        email: form.email.value,
        password: form.password.value
      };
      const res = await fetch('/api/users/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (res.ok) {
        form.reset();
        loadUsers();
      } else {
        const err = await res.json().catch(() => ({}));
        alert(err.message || "Erreur lors de la création de l'utilisateur");
      }
    });

    document.getElementById('addCatwayForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const data = {
        catwayNumber: form.catwayNumber.value,
        catwayType: form.catwayType.value,
        catwayState: form.catwayState.value
      };
      const res = await fetch('/api/catways/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (res.ok) {
        form.reset();
        loadCatwaysSelect();
      } else {
        const err = await res.json().catch(() => ({}));
        alert(err.message || 'Erreur lors de la création du catway');
      }
    });

    document.getElementById('addReservationForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const data = {
        catwayNumber: form.catwayNumber.value,
        clientName: form.clientName.value,
        boatName: form.boatName.value,
        startDate: form.startDate.value,
        endDate: form.endDate.value
      };
      const res = await fetch('/api/reservations/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (res.ok) {
        form.reset();
        loadReservations();
      } else {
        const err = await res.json().catch(() => ({}));
        alert(err.message || 'Erreur lors de la création de la réservation');
      }
    });

    loadUsers();
    loadCatwaysSelect();
    loadReservations();
  </script>
</body>
</html>