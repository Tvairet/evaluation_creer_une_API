<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Modifier la réservation</title>
</head>
<body>
  <h1>Modifier la réservation</h1>
  <form id="editFormReservation">
    <label>Numéro de catway :
      <input type="number" name="catwayNumber" value="<%= reservation.catwayNumber %>">
    </label>
    <br>
    <label>Client :
      <input type="text" name="clientName" value="<%= reservation.clientName %>">
    </label>
    <br>
    <label>Bateau :
      <input type="text" name="boatName" value="<%= reservation.boatName %>">
    </label>
    <br>
    <label>Date de début :
      <input type="date" name="startDate" value="<%= reservation.startDate.toISOString().slice(0, 10) %>">
    </label>
    <br>
    <label>Date de fin :
      <input type="date" name="endDate" value="<%= reservation.endDate.toISOString().slice(0, 10) %>">
    </label>
    <br>
    <button type="submit">Enregistrer</button>
  </form>
  <script>
    const form = document.getElementById('editFormReservation');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const data = {
        catwayNumber: form.catwayNumber.value,
        clientName: form.clientName.value,
        boatName: form.boatName.value,
        startDate: form.startDate.value,
        endDate: form.endDate.value
      };

      const response = await fetch('/api/reservations/<%= reservation.id %>', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      if (response.ok) {
        window.location.href = '/dashboard';
      } else {
        const err = await response.json();
        alert(err.message || 'Erreur lors de la mise à jour');
      }
    });
  </script>
</body>
</html>
