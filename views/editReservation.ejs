<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Modifier la réservation</title>
</head>
<body>
  <h1>Modifier la réservation</h1>
  <form id="editFormReservation">
    <label>Numéro :
      <input type="number" name="number" value="<%= reservation.number %>">
    </label>
    <br>
    <label>Client :
      <input type="text" name="client" value="<%= reservation.client %>">
    </label>
    <br>
    <label>Bateau :
      <input type="text" name="bateau" value="<%= reservation.bateau %>">
    </label>
    <br>
    <label>Date de début :
      <input type="date" name="startDate" value="<%= reservation.startDate %>">
    </label>
    <br>
    <label>Date de fin :
      <input type="date" name="endDate" value="<%= reservation.endDate %>">
    </label>
    <br>
    <button type="submit">Enregistrer</button>
  </form>
  <script>
    const form = document.getElementById('editFormReservation');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const data = {
        numéro: form.number.value,
        client: form.client.value,
        bateau: form.bateau.value,
        startDate: form.startDate.value,
        endDate: form.endDate.value
      };

      const response = await fetch('/api/reservations/<%= reservation.id %>', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      if (response.ok) {
      window.location.href = '/'; // route qui rend index.ejs
    }
    });
  </script>
</body>
</html>
