<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Liste des catways</title>
  <link rel="stylesheet" href="/assets/css/index.css">
</head>
<body>
    <header>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
  
  <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
    <div class="navbar-nav">
      <a class="nav-item nav-link active" href="/">Accueil <span class="sr-only">(current)</span></a>
      <a class="nav-item nav-link" href="/users">Utilisateurs</a>
      <a class="nav-item nav-link" href="#">Réservations</a>
      <a class="nav-item nav-link" href="#">Catways</a>
      <a class="nav-item nav-link disabled" href="#">Tableau de bord</a>
    </div>
  </div>
</nav>
  </header>
  <h1>Liste des catways</h1>
  <table>
    <thead>
      <tr>
        <th>Numéro du catway</th>
        <th>Type de catway</th>
        <th>Etat du catway</th>
      </tr>
    </thead>
    <tbody>
      <% catways.forEach(catway => { %>
        <tr>
          <td><%= catway.numero %></td>
          <td><%= catway.type %></td>
          <td><%= catway.etat %></td>
          <td><a href="/catways/<%= catway.id %>/edit"><button>Modifier</button></a></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</body>
</html>